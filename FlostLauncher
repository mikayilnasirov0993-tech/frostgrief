// FlostLauncher (Windows, C++17)
// Ставит Fabric Loader + Fabric API + мод и создаёт профиль в официальном Minecraft Launcher.
#define WIN32_LEAN_AND_MEAN
#define NOMINMAX
#include <windows.h>
#include <shellapi.h>
#include <tlhelp32.h>
#include <urlmon.h>
#include <bcrypt.h>

#include <algorithm>
#include <cstdlib>
#include <cstring>
#include <ctime>
#include <filesystem>
#include <fstream>
#include <iostream>
#include <iterator>
#include <string>
#include <vector>

#include "profile_json.h"

#ifdef _MSC_VER
#pragma comment(lib, "urlmon.lib")
#pragma comment(lib, "shell32.lib")
#pragma comment(lib, "bcrypt.lib")
#endif

namespace fs = std::filesystem;

static const wchar_t* MC_VERSION     = L"1.21.4";
static const wchar_t* LOADER_VERSION = L"0.16.10";
static const wchar_t* FABRIC_API     = L"0.119.2+1.21.4";
static const char*    PROFILE_ID     = "flostvisual";
static const char*    PROFILE_NAME   = "FlostVisual";

struct Fail { std::wstring msg; };

// ---------- вывод ----------
static void print(const std::wstring& s, WORD color = 7) {
    HANDLE h = GetStdHandle(STD_OUTPUT_HANDLE);
    SetConsoleTextAttribute(h, color);
    DWORD w;
    std::wstring line = s + L"\r\n";
    WriteConsoleW(h, line.c_str(), (DWORD)line.size(), &w, nullptr);
    SetConsoleTextAttribute(h, 7);
}
static void step(const std::wstring& s) { print(L"[*] " + s, 11); }
static void ok(const std::wstring& s)   { print(L"[+] " + s, 10); }
static void warn(const std::wstring& s) { print(L"[!] " + s, 14); }

static void wait_enter() {
    print(L"Нажми Enter для выхода...");
    std::string tmp;
    std::getline(std::cin, tmp);
}

// ---------- утилиты ----------
static std::string to_utf8(const std::wstring& w) {
    if (w.empty()) return {};
    int n = WideCharToMultiByte(CP_UTF8, 0, w.c_str(), (int)w.size(), nullptr, 0, nullptr, nullptr);
    std::string s(n, '\0');
    WideCharToMultiByte(CP_UTF8, 0, w.c_str(), (int)w.size(), s.data(), n, nullptr, nullptr);
    return s;
}

static std::wstring lower(std::wstring s) {
    std::transform(s.begin(), s.end(), s.begin(), [](wchar_t c) { return (wchar_t)towlower(c); });
    return s;
}

static fs::path exe_dir() {
    wchar_t buf[MAX_PATH * 2];
    GetModuleFileNameW(nullptr, buf, (DWORD)(sizeof(buf) / sizeof(buf[0])));
    return fs::path(buf).parent_path();
}

static bool process_running(const wchar_t* name) {
    HANDLE snap = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
    if (snap == INVALID_HANDLE_VALUE) return false;
    PROCESSENTRY32W pe{};
    pe.dwSize = sizeof(pe);
    bool found = false;
    if (Process32FirstW(snap, &pe)) {
        do {
            if (lower(pe.szExeFile) == lower(name)) { found = true; break; }
        } while (Process32NextW(snap, &pe));
    }
    CloseHandle(snap);
    return found;
}

static void download(const std::wstring& url, const fs::path& dest) {
    fs::path part = dest;
    part += L".part";
    std::error_code ec;
    fs::remove(part, ec);
    HRESULT hr = URLDownloadToFileW(nullptr, url.c_str(), part.c_str(), 0, nullptr);
    if (FAILED(hr) || !fs::exists(part) || fs::file_size(part) == 0) {
        fs::remove(part, ec);
        throw Fail{L"Не удалось скачать: " + url + L"\nПроверь интернет / антивирус / фаервол."};
    }
    if (!MoveFileExW(part.c_str(), dest.c_str(), MOVEFILE_REPLACE_EXISTING))
        throw Fail{L"Не удалось записать файл: " + dest.wstring()};
}

static std::string read_file(const fs::path& p) {
    std::ifstream f(p, std::ios::binary);
    return std::string((std::istreambuf_iterator<char>(f)), std::istreambuf_iterator<char>());
}
static void write_file(const fs::path& p, const std::string& data) {
    std::ofstream f(p, std::ios::binary | std::ios::trunc);
    f.write(data.data(), (std::streamsize)data.size());
    if (!f) throw Fail{L"Не удалось записать: " + p.wstring()};
}

static void remove_matching(const fs::path& dir, const std::wstring& prefix) {
    std::error_code ec;
    for (auto& e : fs::directory_iterator(dir, ec)) {
        if (!e.is_regular_file()) continue;
        std::wstring n = lower(e.path().filename().wstring());
        if (n.rfind(prefix, 0) == 0 && e.path().extension() == L".jar") fs::remove(e.path(), ec);
    }
}

static fs::path find_mod_jar(const std::vector<std::wstring>& args) {
    if (args.size() > 1) {            // перетащили jar на exe
        fs::path p = args[1];
        if (fs::exists(p)) return p;
        throw Fail{L"Файл не найден: " + p.wstring()};
    }
    fs::path best;
    fs::file_time_type bestTime{};
    std::error_code ec;
    for (auto& e : fs::directory_iterator(exe_dir(), ec)) {
        if (!e.is_regular_file()) continue;
        std::wstring n = lower(e.path().filename().wstring());
        if (n.rfind(L"flostvisual", 0) != 0 || e.path().extension() != L".jar") continue;
        if (n.find(L"sources") != std::wstring::npos || n.find(L"dev") != std::wstring::npos) continue;
        auto t = fs::last_write_time(e.path());
        if (best.empty() || t > bestTime) { best = e.path(); bestTime = t; }
    }
    if (best.empty())
        throw Fail{L"Не найден flostvisual-*.jar.\nПоложи jar мода рядом с установщиком или перетащи jar на этот exe.\nПапка: " +
                   exe_dir().wstring()};
    return best;
}

static std::string iso_now() {
    std::time_t t = std::time(nullptr);
    std::tm tm{};
    gmtime_s(&tm, &t);
    char buf[64];
    std::strftime(buf, sizeof(buf), "%Y-%m-%dT%H:%M:%S.000Z", &tm);
    return buf;
}


// ---------- вход по коду ----------
// SHA-256 от "FlostLauncher|<код>". Код по умолчанию: flost
// Свой код: FlostLauncher.exe --hash мойкод  -> вставь результат сюда и пересобери.
static const char* CODE_HASH = "84be566f7db8cdbec8646e0acc0c936a36d369f0d57f8c2860520c840dcd0a3e";

static std::string sha256_hex(const std::string& in) {
    unsigned char out[32] = {};
    BCryptHash(BCRYPT_SHA256_ALG_HANDLE, nullptr, 0, (PUCHAR)in.data(), (ULONG)in.size(), out, 32);
    static const char* hx = "0123456789abcdef";
    std::string r;
    for (unsigned char b : out) { r += hx[b >> 4]; r += hx[b & 15]; }
    return r;
}

static std::string read_hidden(const std::wstring& prompt) {
    HANDLE in = GetStdHandle(STD_INPUT_HANDLE);
    DWORD mode = 0;
    bool tty = GetConsoleMode(in, &mode) != 0;
    if (tty) SetConsoleMode(in, mode & ~ENABLE_ECHO_INPUT);
    HANDLE out = GetStdHandle(STD_OUTPUT_HANDLE);
    DWORD w;
    WriteConsoleW(out, prompt.c_str(), (DWORD)prompt.size(), &w, nullptr);
    std::string s;
    std::getline(std::cin, s);
    if (tty) SetConsoleMode(in, mode);
    WriteConsoleW(out, L"\r\n", 2, &w, nullptr);
    while (!s.empty() && (s.back() == '\r' || s.back() == '\n')) s.pop_back();
    return s;
}

static bool login() {
    for (int i = 0; i < 3; ++i) {
        std::string code = read_hidden(L"Код для входа: ");
        if (sha256_hex("FlostLauncher|" + code) == CODE_HASH) { ok(L"Вход выполнен"); return true; }
        warn(L"Неверный код (" + std::to_wstring(2 - i) + L" попыток осталось)");
    }
    return false;
}

// ---------- основной сценарий ----------
static void run(const std::vector<std::wstring>& args) {
    std::wstring ver = MC_VERSION, loader = LOADER_VERSION, api = FABRIC_API;
    std::wstring versionId = L"fabric-loader-" + loader + L"-" + ver;

    wchar_t* appdata = _wgetenv(L"APPDATA");
    if (!appdata) throw Fail{L"Не найдена переменная APPDATA."};
    fs::path mcDir      = fs::path(appdata) / L".minecraft";
    fs::path gameDir    = mcDir / L"FlostVisual";
    fs::path modsDir    = gameDir / L"mods";
    fs::path profilesJs = mcDir / L"launcher_profiles.json";

    // 1. jar мода
    fs::path jar = find_mod_jar(args);
    ok(L"Мод: " + jar.filename().wstring());

    // 2. официальный лаунчер
    if (!fs::exists(profilesJs))
        throw Fail{L"Не найден " + profilesJs.wstring() +
                   L"\nУстанови официальный Minecraft Launcher, запусти его один раз, закрой и повтори."};
    if (process_running(L"MinecraftLauncher.exe")) {
        warn(L"Закрой Minecraft Launcher, иначе он может перезаписать профиль.");
        print(L"Закрыл? Нажми Enter.");
        std::string tmp;
        std::getline(std::cin, tmp);
    }

    // 3. Fabric Loader
    step(L"Fabric Loader " + loader + L" для " + ver);
    fs::path verDir = mcDir / L"versions" / versionId;
    fs::create_directories(verDir);
    download(L"https://meta.fabricmc.net/v2/versions/loader/" + ver + L"/" + loader + L"/profile/json",
             verDir / (versionId + L".json"));
    fs::path dummyJar = verDir / (versionId + L".jar");
    if (!fs::exists(dummyJar)) std::ofstream(dummyJar, std::ios::binary).close();
    ok(L"Fabric Loader установлен");

    // 4. Fabric API
    step(L"Fabric API " + api);
    fs::create_directories(modsDir);
    remove_matching(modsDir, L"fabric-api");
    std::wstring apiEnc = api;
    apiEnc.replace(apiEnc.find(L'+'), 1, L"%2B");
    std::wstring apiFile = L"fabric-api-" + api + L".jar";
    download(L"https://maven.fabricmc.net/net/fabricmc/fabric-api/fabric-api/" + apiEnc + L"/fabric-api-" + apiEnc + L".jar",
             modsDir / apiFile);
    ok(L"Fabric API: " + apiFile);

    // 5. мод
    step(L"Копирую FlostVisual");
    remove_matching(modsDir, L"flostvisual");
    std::error_code ec;
    fs::copy_file(jar, modsDir / jar.filename(), fs::copy_options::overwrite_existing, ec);
    if (ec) throw Fail{L"Не удалось скопировать мод в " + modsDir.wstring()};
    ok(L"Мод скопирован в " + modsDir.wstring());

    // 6. профиль
    step(L"Создаю профиль FlostVisual");
    fs::copy_file(profilesJs, fs::path(profilesJs).concat(L".bak"), fs::copy_options::overwrite_existing, ec);
    std::string json = read_file(profilesJs);
    std::string now = iso_now();
    std::string entry =
        "{\n      \"created\": \"" + now + "\",\n"
        "      \"gameDir\": \"" + json_escape(to_utf8(gameDir.wstring())) + "\",\n"
        "      \"icon\": \"Furnace\",\n"
        "      \"javaArgs\": \"-Xmx4G -XX:+UseG1GC\",\n"
        "      \"lastUsed\": \"" + now + "\",\n"
        "      \"lastVersionId\": \"" + to_utf8(versionId) + "\",\n"
        "      \"name\": \"" + PROFILE_NAME + "\",\n"
        "      \"type\": \"custom\"\n    }";
    switch (add_profile(json, PROFILE_ID, entry)) {
        case AddResult::Added:
            write_file(profilesJs, json);
            ok(L"Профиль создан (резервная копия: launcher_profiles.json.bak)");
            break;
        case AddResult::Exists:
            ok(L"Профиль FlostVisual уже есть - оставляю как есть");
            break;
        case AddResult::Error:
            throw Fail{L"Не удалось разобрать launcher_profiles.json. Файл не изменён."};
    }

    print(L"");
    print(L"Готово! Открой Minecraft Launcher, выбери профиль \"FlostVisual\" и жми Играть.", 10);
    print(L"В игре: Right Shift - меню.");
}

int main() {
    SetConsoleOutputCP(CP_UTF8);
    SetConsoleTitleW(L"FlostLauncher");

    std::vector<std::wstring> args;
    int argc = 0;
    if (LPWSTR* argv = CommandLineToArgvW(GetCommandLineW(), &argc)) {
        for (int i = 0; i < argc; ++i) args.push_back(argv[i]);
        LocalFree(argv);
    }

    print(L"");
    print(L"  FlostLauncher  (FlostVisual / Minecraft 1.21.4 / Fabric)", 13);
    print(L"");
    if (args.size() > 2 && args[1] == L"--hash") {      // генератор хэша для своего кода
        print(L"Хэш: " + std::wstring(sha256_hex("FlostLauncher|" + to_utf8(args[2])).begin(),
                                       sha256_hex("FlostLauncher|" + to_utf8(args[2])).end()));
        return 0;
    }
    if (!login()) { print(L"Доступ запрещён.", 12); wait_enter(); return 1; }
    print(L"");
    int code = 0;
    try {
        run(args);
    } catch (const Fail& f) {
        print(L"[x] " + f.msg, 12);
        code = 1;
    } catch (const std::exception& e) {
        print(L"[x] Ошибка: " + std::wstring(e.what(), e.what() + strlen(e.what())), 12);
        code = 1;
    }
    print(L"");
    wait_enter();
    return code;
}
