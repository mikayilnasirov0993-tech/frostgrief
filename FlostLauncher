#pragma once
// Вставка профиля в launcher_profiles.json без внешних JSON-библиотек.
#include <string>

inline std::string json_escape(const std::string& s) {
    std::string o;
    for (unsigned char c : s) {
        switch (c) {
            case '\\': o += "\\\\"; break;
            case '"':  o += "\\\""; break;
            case '\n': o += "\\n";  break;
            case '\r': o += "\\r";  break;
            case '\t': o += "\\t";  break;
            default:   o += (char)c;
        }
    }
    return o;
}

enum class AddResult { Added, Exists, Error };

inline bool is_ws(char c) { return c == ' ' || c == '\t' || c == '\r' || c == '\n'; }

inline AddResult add_profile(std::string& json, const std::string& id,
                             const std::string& entry /* {...} */) {
    const std::string key = "\"" + id + "\"";
    if (json.find(key) != std::string::npos) return AddResult::Exists;

    size_t p = json.find("\"profiles\"");
    if (p != std::string::npos) {
        size_t colon = json.find(':', p);
        if (colon == std::string::npos) return AddResult::Error;
        size_t brace = colon + 1;
        while (brace < json.size() && is_ws(json[brace])) ++brace;
        if (brace >= json.size() || json[brace] != '{') return AddResult::Error;
        size_t j = brace + 1;
        while (j < json.size() && is_ws(json[j])) ++j;
        bool empty = (j < json.size() && json[j] == '}');
        std::string ins = "\n    " + key + ": " + entry + (empty ? "" : ",");
        json.insert(brace + 1, ins);
        return AddResult::Added;
    }

    // ключа "profiles" нет - добавляем в корневой объект
    size_t last = json.rfind('}');
    if (last == std::string::npos) return AddResult::Error;
    size_t k = last;
    while (k > 0 && is_ws(json[k - 1])) --k;
    bool rootEmpty = (k > 0 && json[k - 1] == '{');
    std::string ins = std::string(rootEmpty ? "" : ",") +
                      "\n  \"profiles\": {\n    " + key + ": " + entry + "\n  }\n";
    json.insert(last, ins);
    return AddResult::Added;
}

FlostLauncher (C++), Windows, лицензионный Minecraft 1.21.4 + мод FlostVisual

СБОРКА EXE
  A) Залей папку в GitHub -> Actions -> build-launcher -> скачай FlostLauncher.exe из Artifacts.
  B) Или build.bat (нужен MinGW-w64 новой версии или Visual Studio Build Tools).

КОД ДЛЯ ВХОДА
  По умолчанию: flost   (3 попытки)
  Свой код:
    1. В командной строке: FlostLauncher.exe --hash мойкод
    2. Скопируй выданный хэш в installer.cpp, строка CODE_HASH, пересобери.
  Внимание: это лёгкая защита от посторонних. Опытный человек может обойти проверку в самом exe.

ИСПОЛЬЗОВАНИЕ
  1. FlostLauncher.exe + flostvisual-2.0.0.jar в одну папку.
  2. Один раз запусти официальный Minecraft Launcher и закрой.
  3. Запусти FlostLauncher.exe, введи код.
  4. В лаунчере: профиль FlostVisual -> Играть.

